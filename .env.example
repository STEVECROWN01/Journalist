# Base de données PostgreSQL (Railway)
# Copiez dans .env l'URL publique fournie par Railway :
#   Railway > votre projet PostgreSQL > onglet Variables > DATABASE_URL
# (elle ressemble à postgresql://postgres:xxxx@containers-xxxx.rlwy.net:xxxx/railway)
DATABASE_URL="postgresql://postgres:motdepasse@containers-xxxx.rlwy.net:5432/railway"

# Identifiants du compte administrateur (créés/réinitialisés par l'amorçage
# à chaque déploiement si le mot de passe ne correspond pas)
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD="Changez-Moi-2026!"

# Secret de signature des sessions back-office (générez une valeur longue et aléatoire)
ADMIN_SESSION_SECRET="chaine-aleatoire-longue-et-secrete"

# URL publique du site (métadonnées, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://journalistefr.vercel.app"
